{
  "name": "@jaingxyz/personal-gmail-mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server for a personal Gmail (consumer Google account) inbox and calendar, via the Gmail and Google Calendar APIs. Stdio transport, loopback OAuth, OS-keyring token cache.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "jaingxyz",
  "homepage": "https://github.com/jaingxyz/personal-gmail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaingxyz/personal-gmail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jaingxyz/personal-gmail-mcp/security/advisories/new"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-calendar",
    "google-api",
    "claude",
    "anthropic"
  ],
  "bin": {
    "personal-gmail-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "whoami": "node dist/scripts/whoami.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm run lint && npm run format:check && npm test",
    "clean": "rm -rf dist coverage"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "googleapis": "^173.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
